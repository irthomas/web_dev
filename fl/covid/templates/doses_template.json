{
  "$schema": "https://vega.github.io/schema/vega-lite/v4.json",
  "description": "COVID vaccine doses delivered to Belgium",
  "width": 1000,
  "height": 500,
  "padding": 5,
  "data": {
    "values": [], 
    "format": { "parse": { "x": "date" } } 
  },
  "layer": [
    {
      "encoding": {
		"x": { "field": "doses_date", "type": "temporal" }, 
		"y": { "field": "doses", "type": "quantitative" }, 
		"color": { 
		  "field": "dosage", 
		  "type": "nominal",
		  "legend":{"title":"Dosage Requirement" }
		  }
	  },
      "layer": [
        {"mark": "line"},
        {
          "selection": {
            "label": {
              "type": "single",
              "nearest": true,
              "on": "mouseover",
              "encodings": ["x"],
              "empty": "none"
            }
          },
          "mark": "point",
          "encoding": {
            "opacity": {
              "condition": {"selection": "label", "value": 1},
              "value": 0
            }
          }
        }
      ]
    },
    {
      "transform": [{"filter": {"selection": "label"}}],
      "layer": [
        {
          "mark": {"type": "rule", "color": "gray"},
          "encoding": {
            "x": {"type": "temporal", "field": "doses_date", "aggregate": "min"}
          }
        },
        {
          "encoding": {
            "text": {"type": "quantitative", "field": "doses"},
            "x": {"type": "temporal", "field": "doses_date", "title":"Date"},
            "y": {"type": "quantitative", "field": "doses", "title":"Cumulative number of vaccine doses delivered"}
          },
          "layer": [
            {
              "mark": {
                "type": "text",
                "stroke": "black",
                "strokeWidth": 2,
                "align": "left",
                "dx": 5,
                "dy": -5
              }
            },
            {
              "mark": {"type": "text", "align": "left", "dx": 5, "dy": -5},
              "encoding": {
                "color": {"type": "nominal", "field": "dosage"}
              }
            }
          ]
        }
      ]
    }
  ],
  "config":{
  "background": "black",
  "title": {"color": "#fff"},
  "style": {"guide-label": {"fill": "#fff"}, "guide-title": {"fill": "#fff"}},
  "axis": {"domainColor": "#fff", "gridColor": "#888", "tickColor": "#fff"}
  }
}